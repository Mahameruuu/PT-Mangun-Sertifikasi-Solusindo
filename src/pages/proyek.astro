---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import Lightbox from '../components/Lightbox.astro';
import CTASection from '../components/CTASection.astro';

const labels = {
  sipil: 'Sipil',
  mekanikal: 'Mekanikal',
  elektrikal: 'Elektrikal',
  pabrikasi: 'Pabrikasi',
  parkir: 'Sistem Parkir',
  antrian: 'Sistem Antrian',
  perbankan: 'Mesin Perbankan',
} as const;

const projects = (await getCollection('proyek')).sort((a, b) => a.data.order - b.data.order);
const withFull = await Promise.all(
  projects.map(async (p) => ({
    ...p,
    full: await Promise.all(p.data.photos.map((ph) => getImage({ src: ph.src, width: 1600 }))),
  })),
);
// Label ringkas khusus tombol filter (label lengkap tetap dipakai di kartu).
const filterLabels: Record<keyof typeof labels, string> = {
  sipil: 'Sipil', mekanikal: 'Mekanikal', elektrikal: 'Elektrikal', pabrikasi: 'Pabrikasi',
  parkir: 'Parkir', antrian: 'Antrian', perbankan: 'Perbankan',
};
const usedCategories = (Object.keys(labels) as (keyof typeof labels)[]).filter((k) => projects.some((p) => p.data.category === k));
const countIn = (k: string) => projects.filter((p) => p.data.category === k).length;
---
<BaseLayout
  title="Proyek"
  description="Dokumentasi pekerjaan sipil, mekanikal, elektrikal, pabrikasi besi & baja tahan karat, instalasi sistem parkir otomatis, sistem antrian, dan servis mesin perbankan."
>
  <PageHeader
    title="Portofolio Proyek"
    intro="Dokumentasi pekerjaan tim kami di lapangan, meliputi instalasi, perawatan, renovasi, dan pabrikasi."
    crumbs={[{ href: '/proyek/', label: 'Proyek' }]}
  />

  <div class="pfilter">
    <div class="container">
      <div class="pfilter__chips" role="group" aria-label="Filter kategori proyek">
        <button type="button" class="chip is-active" data-filter="all" aria-pressed="true">
          Semua <span class="chip__count">{projects.length}</span>
        </button>
        {usedCategories.map((k) => (
          <button type="button" class="chip" data-filter={k} aria-pressed="false">
            {filterLabels[k]} <span class="chip__count">{countIn(k)}</span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <section class="section projects-section">
    <div class="container">
      <p class="pmeta" aria-live="polite">Menampilkan <strong data-count>{projects.length}</strong> proyek</p>

      <div class="pgrid">
        {withFull.map((p) => (
          <article class="pcard" id={p.id} data-category={p.data.category}>
            <a class="pcard__media" href={p.full[0].src} data-lightbox={p.id} data-caption={p.data.title} aria-label={`Lihat ${p.data.photos.length} foto: ${p.data.title}`}>
              <Image
                src={p.data.photos[0].src}
                alt={p.data.photos[0].alt}
                widths={[360, 540, 720]}
                sizes="(min-width: 900px) 380px, (min-width: 480px) 46vw, 92vw"
                loading="lazy"
              />
              <span class="pcard__badge"><Icon name="images" /> {p.data.photos.length} foto</span>
              <span class="pcard__zoom" aria-hidden="true"><Icon name="zoom" /></span>
            </a>
            {p.full.slice(1).map((f, i) => (
              <a href={f.src} data-lightbox={p.id} data-caption={p.data.title} hidden>{p.data.photos[i + 1].alt}</a>
            ))}
            <div class="pcard__body">
              <span class="pcard__cat">{labels[p.data.category]}</span>
              <h2 class="pcard__title">{p.data.title}</h2>
              {p.data.scope.length > 0 && <p class="pcard__scope">{p.data.scope.join(' · ')}</p>}
              <a class="pcard__more" href={p.full[0].src} data-lightbox-open={p.id}>
                Lihat galeri <Icon name="arrow" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection title="Wujudkan proyek Anda bersama tim kami" text="Dari pekerjaan sipil, mekanikal, elektrikal, dan pabrikasi hingga instalasi sistem parkir dan antrian, tim kami siap menangani proyek Anda." />
  <Lightbox />
</BaseLayout>

<script>
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.pfilter .chip')];
  const cards = [...document.querySelectorAll<HTMLElement>('.pcard')];
  const count = document.querySelector<HTMLElement>('[data-count]');
  const section = document.querySelector<HTMLElement>('.projects-section');

  const apply = (filter: string) => {
    let shown = 0;
    cards.forEach((c) => {
      const on = filter === 'all' || c.dataset.category === filter;
      c.hidden = !on;
      if (on) shown++;
    });
    chips.forEach((b) => {
      const on = b.dataset.filter === filter;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-pressed', String(on));
    });
    if (count) count.textContent = String(shown);
  };

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      apply(chip.dataset.filter ?? 'all');
      chip.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      // Jika pengguna sudah jauh di bawah, kembalikan ke awal daftar proyek.
      const bar = document.querySelector<HTMLElement>('.pfilter');
      if (section && bar && section.getBoundingClientRect().top < bar.getBoundingClientRect().bottom - 1) {
        scrollTo({ top: scrollY + section.getBoundingClientRect().top - bar.getBoundingClientRect().bottom, behavior: 'smooth' });
      }
    }),
  );
</script>

<style>
  /* Tautan #proyek dari halaman lain: beri jarak untuk header + filter yang menempel */
  :global(html) { scroll-padding-top: calc(var(--header-h) + 5.5rem); }

  /* ---------- Filter: satu baris, menempel di bawah header ---------- */
  .pfilter {
    position: sticky;
    top: var(--header-h);
    z-index: 25;
    background: rgb(255 255 255 / 0.96);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .pfilter__chips {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-block: 0.8rem;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    scrollbar-width: none;
    scroll-padding-inline: var(--gutter);
  }
  .pfilter__chips::-webkit-scrollbar { display: none; }
  /* HP & tablet: tepi kanan memudar sebagai petunjuk bahwa chip bisa digeser */
  @media (max-width: 899px) {
    .pfilter__chips { mask-image: linear-gradient(90deg, #000 calc(100% - 48px), transparent); }
  }
  /* Laptop sempit: rapatkan chip agar tetap satu baris */
  @media (min-width: 900px) and (max-width: 1199px) {
    .pfilter__chips { gap: 0.3rem; }
    .pfilter .chip { padding: 0.35rem 0.45rem 0.35rem 0.7rem; font-size: 0.82rem; gap: 0.3rem; }
  }

  .chip {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 40px;
    padding: 0.4rem 0.6rem 0.4rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: #fff;
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }
  .chip:hover { border-color: var(--navy-900); }
  .chip.is-active { background: var(--navy-900); border-color: var(--navy-900); color: #fff; }
  .chip__count {
    min-width: 1.5rem;
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    background: var(--bg-muted);
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    text-align: center;
  }
  .chip.is-active .chip__count { background: rgb(255 255 255 / 0.18); color: #fff; }

  /* ---------- Grid kartu proyek ---------- */
  .projects-section { padding-top: 1.75rem; }
  .pmeta { margin: 0 0 1.25rem; font-size: var(--fs-sm); color: var(--text-muted); }
  .pmeta strong { color: var(--text); }
  .pgrid { display: grid; gap: 1.25rem; }
  @media (min-width: 480px) { .pgrid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) { .pgrid { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; } }

  .pcard {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: box-shadow 0.25s, transform 0.25s;
  }
  .pcard:hover { box-shadow: var(--shadow-lg); transform: translateY(-3px); }
  .pcard[hidden] { display: none; }
  .pcard:target { outline: 3px solid var(--amber-400); outline-offset: 3px; }

  .pcard__media { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--bg-muted); }
  .pcard__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .pcard:hover .pcard__media :global(img) { transform: scale(1.05); }
  .pcard__badge {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: rgb(7 21 40 / 0.78);
    backdrop-filter: blur(4px);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 600;
  }
  .pcard__badge :global(svg) { width: 15px; height: 15px; }
  .pcard__zoom {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(7 21 40 / 0.35);
    color: #fff;
    opacity: 0;
    transition: opacity 0.25s;
  }
  .pcard__zoom :global(svg) { width: 36px; height: 36px; }
  .pcard:hover .pcard__zoom { opacity: 1; }

  .pcard__body { flex: 1; display: flex; flex-direction: column; padding: 1.1rem 1.25rem 1.25rem; }
  .pcard__cat { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--blue-500); }
  .pcard__title { margin: 0.35rem 0 0.5rem; font-size: 1.12rem; line-height: 1.35; }
  .pcard__scope { margin: 0 0 0.75rem; font-size: var(--fs-sm); color: var(--text-muted); line-height: 1.5; }
  .pcard__more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    align-self: flex-start;
    font-weight: 600;
    font-size: var(--fs-sm);
    text-decoration: none;
  }
  .pcard__more :global(svg) { width: 15px; height: 15px; transition: transform 0.2s; }
  .pcard__more:hover :global(svg) { transform: translateX(3px); }

  /* ---------- HP kecil: kartu format daftar (foto kiri, teks kanan) ---------- */
  @media (max-width: 479px) {
    .pgrid { gap: 0.75rem; }
    .pcard { flex-direction: row; }
    .pcard:hover { transform: none; }
    .pcard__media { flex: none; width: 38%; aspect-ratio: auto; min-height: 128px; }
    .pcard__badge { left: 0.4rem; bottom: 0.4rem; padding: 0.2rem 0.45rem; font-size: 0.68rem; gap: 0.25rem; }
    .pcard__badge :global(svg) { width: 12px; height: 12px; }
    .pcard__body { padding: 0.75rem 0.85rem 0.85rem; }
    .pcard__cat { font-size: 0.64rem; }
    .pcard__title { font-size: 0.98rem; margin: 0.2rem 0 0.4rem; }
    .pcard__scope { display: none; }
    .pcard__more { font-size: 0.8rem; }
  }
</style>
