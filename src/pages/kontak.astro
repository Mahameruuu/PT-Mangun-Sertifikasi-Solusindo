---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { site, fullAddress, maps } from '../data/site';
import { categories } from '../data/categories';

---
<BaseLayout
  title="Kontak"
  description={`Hubungi ${site.name} untuk penawaran produk dan layanan. Kantor pusat: ${fullAddress}. Telepon ${site.phone.display}.`}
>
  <PageHeader
    title="Hubungi Kami"
    intro="Diskusikan kebutuhan Anda bersama tim kami. Kami siap membantu menyiapkan solusi dan penawaran yang sesuai."
    crumbs={[{ href: '/kontak/', label: 'Kontak' }]}
  />

  <!-- Informasi kontak | Peta -->
  <section class="section" id="lokasi">
    <div class="container contact">
      <div class="info" data-reveal>
        <h2 class="info__title">Informasi Kontak</h2>
        <p class="info__intro">Tim kami siap melayani melalui telepon, WhatsApp, maupun formulir pesan.</p>
        <dl class="info__list">
          <div>
            <dt><Icon name="pin" /> Alamat</dt>
            <dd>{fullAddress}</dd>
          </div>
          <div>
            <dt><Icon name="phone" /> Telepon / WhatsApp</dt>
            <dd><a href={`tel:${site.phone.tel}`}>{site.phone.display}</a></dd>
          </div>
          {site.mobiles.length > 0 && (
            <div>
              <dt><Icon name="smartphone" /> Seluler</dt>
              <dd>{site.mobiles.map((m) => <a href={`tel:${m.tel}`}>{m.display}</a>)}</dd>
            </div>
          )}
          <div>
            <dt><Icon name="map-pinned" /> Titik layanan</dt>
            <dd>
              {site.servicePoints.map((sp) => (
                <span>{sp.city} ({sp.contact}) · <a href={`tel:${sp.tel}`}>{sp.display}</a></span>
              ))}
            </dd>
          </div>
          <div>
            <dt><Icon name="facebook" /> Media sosial</dt>
            <dd><a href={site.facebook} target="_blank" rel="noopener">Facebook</a></dd>
          </div>
        </dl>
      </div>
      <div class="map" data-reveal="right">
        <iframe
          title={`Peta lokasi ${site.name}`}
          src={maps.embed}
          loading="lazy"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Formulir -->
  <section class="section section--soft" aria-labelledby="form-title">
    <div class="container">
      <div class="form-card" data-reveal>
        <div class="form-card__head">
          <h2 id="form-title">Kirim Pesan</h2>
          <p>Ceritakan kebutuhan Anda. Pesan akan dibuka di WhatsApp dan siap dikirim langsung ke tim kami.</p>
        </div>

        <form id="wa-form" novalidate>
          <div class="form-grid">
            <div class="field">
              <label for="f-name">Nama lengkap <span class="req" aria-hidden="true">*</span></label>
              <input id="f-name" name="name" autocomplete="name" placeholder="Nama Anda" required aria-describedby="e-name" />
              <p class="field__error" id="e-name" hidden>Nama wajib diisi.</p>
            </div>
            <div class="field">
              <label for="f-company">Instansi / perusahaan</label>
              <input id="f-company" name="company" autocomplete="organization" placeholder="Opsional" />
            </div>
            <div class="field">
              <label for="f-city">Kota</label>
              <input id="f-city" name="city" autocomplete="address-level2" placeholder="Opsional" />
            </div>
            <div class="field">
              <label for="f-topic">Kebutuhan</label>
              <div class="select">
                <select id="f-topic" name="topic">
                  <option value="">Pilih kebutuhan</option>
                  <optgroup label="Produk">
                    {categories.map((c) => <option>{c.name}</option>)}
                  </optgroup>
                  <optgroup label="Layanan">
                    <option>Servis / perawatan mesin</option>
                    <option>Pekerjaan sipil / mekanikal / elektrikal</option>
                    <option>Lainnya</option>
                  </optgroup>
                </select>
                <Icon name="chevron" />
              </div>
            </div>
            <div class="field field--full">
              <label for="f-message">Pesan <span class="req" aria-hidden="true">*</span></label>
              <textarea id="f-message" name="message" rows="5" placeholder="Jelaskan kebutuhan Anda, misalnya jenis produk, jumlah unit, atau lokasi pekerjaan." required aria-describedby="e-message"></textarea>
              <p class="field__error" id="e-message" hidden>Pesan wajib diisi.</p>
            </div>
          </div>
          <div class="form-foot">
            <p class="form-note"><span class="req">*</span> Wajib diisi</p>
            <button class="btn btn--wa form-submit" type="submit"><Icon name="whatsapp" /> Kirim via WhatsApp</button>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { site } from '../data/site';

  const form = document.getElementById('wa-form') as HTMLFormElement;
  const required = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')];

  const check = (el: HTMLInputElement | HTMLTextAreaElement) => {
    const ok = el.value.trim() !== '';
    el.setAttribute('aria-invalid', String(!ok));
    const msg = document.getElementById(el.getAttribute('aria-describedby') ?? '');
    if (msg) msg.hidden = ok;
    return ok;
  };
  required.forEach((el) => el.addEventListener('input', () => el.getAttribute('aria-invalid') === 'true' && check(el)));

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const invalid = required.filter((el) => !check(el));
    if (invalid.length) {
      invalid[0].focus();
      return;
    }
    const d = new FormData(form);
    const get = (k: string) => String(d.get(k) ?? '').trim();
    const lines = [
      `Halo ${site.name}, saya ${get('name')}${get('company') ? ` dari ${get('company')}` : ''}${get('city') ? ` (${get('city')})` : ''}.`,
    ];
    if (get('topic')) lines.push(`Kebutuhan: ${get('topic')}`);
    lines.push('', get('message'));
    window.open(`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
  });
</script>

<style>
  /* ---------- Formulir + info ---------- */
  .contact { display: grid; gap: 1.5rem; align-items: start; }
  @media (min-width: 900px) { .contact { grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); gap: 3rem; align-items: stretch; } }

  .form-card {
    max-width: 880px;
    margin-inline: auto;
    padding: clamp(1.25rem, 0.9rem + 1.6vw, 2.25rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #fff;
    box-shadow: var(--shadow);
  }
  .form-card__head { margin-bottom: 1.5rem; }
  .form-card__head h2 { margin: 0 0 0.25rem; font-size: var(--fs-xl); }
  .form-card__head p { margin: 0; color: var(--text-muted); font-size: 0.95rem; }

  .form-grid { display: grid; gap: 1rem 1.25rem; }
  @media (min-width: 640px) { .form-grid { grid-template-columns: 1fr 1fr; } .field--full { grid-column: 1 / -1; } }
  .field { display: grid; gap: 0.4rem; align-content: start; }
  label { font-weight: 600; font-size: var(--fs-sm); color: var(--navy-900); }
  .req { color: #c0392b; }
  input, select, textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
    font: inherit;
    font-size: 1rem; /* 16px: mencegah zoom otomatis di iOS */
    color: var(--text);
    transition: border-color 0.15s, background-color 0.15s, box-shadow 0.15s;
  }
  ::placeholder { color: #8a95a8; }
  input:hover, select:hover, textarea:hover { border-color: #c4cddb; }
  input:focus, select:focus, textarea:focus { outline: none; background: #fff; border-color: var(--blue-500); box-shadow: 0 0 0 3px rgb(47 111 208 / 0.18); }
  [aria-invalid='true'] { border-color: #c0392b; background: #fdf3f2; }
  textarea { resize: vertical; min-height: 140px; }
  .select { position: relative; }
  .select select { appearance: none; padding-right: 2.5rem; cursor: pointer; }
  .select :global(svg) { position: absolute; right: 0.9rem; top: 50%; width: 16px; height: 16px; transform: translateY(-50%) rotate(90deg); color: var(--text-muted); pointer-events: none; }
  .field__error { margin: 0; font-size: 0.82rem; font-weight: 600; color: #c0392b; }

  .form-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1rem; margin-top: 1.5rem; }
  .form-note { margin: 0; font-size: var(--fs-sm); color: var(--text-muted); }
  @media (max-width: 639px) { .form-submit { width: 100%; } .form-note { order: 2; } }

  /* ---------- Informasi kontak (daftar ringkas, tanpa kotak) ---------- */
  .info__title { margin: 0 0 0.4rem; font-size: var(--fs-xl); }
  .info__intro { margin: 0 0 1.25rem; color: var(--text-muted); }
  .info__list { margin: 0; }
  .info__list > div { padding: 1rem 0; border-top: 1px solid var(--border); }
  .info__list > div:last-child { border-bottom: 1px solid var(--border); }
  .info__list dt { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.3rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }
  .info__list dt :global(svg) { width: 16px; height: 16px; color: var(--blue-500); }
  .info__list dd { margin: 0; display: flex; flex-direction: column; gap: 0.15rem; color: var(--text); line-height: 1.55; }
  .info__list a { font-weight: 600; text-decoration: none; white-space: nowrap; }
  .info__list a:hover { text-decoration: underline; }

  /* ---------- Peta ---------- */
  /* Peta: 4:3 saat bertumpuk; di desktop setinggi kolom informasi */
  .map { border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border); box-shadow: var(--shadow-lg); background: var(--bg-muted); aspect-ratio: 4 / 3; width: 100%; }
  @media (min-width: 640px) and (max-width: 899px) { .map { aspect-ratio: 16 / 9; } }
  @media (min-width: 900px) { .map { aspect-ratio: auto; height: 100%; min-height: 420px; } }
  .map iframe { width: 100%; height: 100%; border: 0; display: block; }
</style>
