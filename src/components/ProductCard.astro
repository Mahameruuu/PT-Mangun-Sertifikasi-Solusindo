---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  product: CollectionEntry<'produk'>;
  /** Versi ringkas (beranda): 2 kolom di mobile, teks lebih kecil. */
  compact?: boolean;
}
const { product, compact = false } = Astro.props;
const { name, type, images, category } = product.data;
const cover = images[0];
---
<a class:list={['product-card', { 'product-card--compact': compact }]} href={`/produk/${category}/${product.id}/`}>
  <div class="product-card__media">
    {cover ? (
      <Image src={cover.src} alt={cover.alt} widths={[280, 420, 560]} sizes={compact ? '(min-width: 900px) 280px, 45vw' : '(min-width: 900px) 280px, (min-width: 640px) 45vw, 90vw'} loading="lazy" />
    ) : (
      <span class="product-card__placeholder">Foto segera tersedia</span>
    )}
  </div>
  <div class="product-card__body">
    <span class="product-card__type">{type}</span>
    <h3 class="product-card__name">{name}</h3>
    <span class="product-card__more">Lihat detail <Icon name="arrow" /></span>
  </div>
</a>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s, transform 0.2s, border-color 0.2s;
  }
  .product-card:hover {
    border-color: transparent;
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
    color: inherit;
  }
  /* Gambar diposisikan absolut agar rasio 4:3 tidak bisa didorong oleh ukuran gambar. */
  .product-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    background: linear-gradient(180deg, #f1f4f9, #e4eaf3);
    overflow: hidden;
  }
  .product-card__media :global(img) {
    position: absolute;
    inset: 1.25rem;
    width: calc(100% - 2.5rem);
    height: calc(100% - 2.5rem);
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: transform 0.4s;
  }
  .product-card:hover .product-card__media :global(img) { transform: scale(1.05); }
  .product-card__placeholder { color: var(--text-muted); font-size: var(--fs-sm); }
  .product-card__body { padding: 1.1rem 1.25rem 1.3rem; display: flex; flex-direction: column; flex: 1; }
  .product-card__type {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--blue-500);
  }
  .product-card__name { font-size: 1.1rem; margin: 0.3rem 0 0.75rem; }
  .product-card__more { margin-top: auto; display: inline-flex; align-items: center; gap: 0.35rem; font-weight: 600; font-size: var(--fs-sm); color: var(--navy-700); }
  .product-card__more :global(svg) { width: 15px; height: 15px; transition: transform 0.2s; }
  .product-card:hover .product-card__more :global(svg) { transform: translateX(3px); }

  /* Ringkas: dipakai di beranda */
  @media (max-width: 639px) {
    .product-card--compact .product-card__media :global(img) { inset: 0.75rem; width: calc(100% - 1.5rem); height: calc(100% - 1.5rem); }
    .product-card--compact .product-card__body { padding: 0.75rem 0.85rem 0.9rem; }
    .product-card--compact .product-card__type { font-size: 0.66rem; letter-spacing: 0.02em; }
    .product-card--compact .product-card__name { font-size: 0.92rem; margin: 0.2rem 0 0.5rem; }
    .product-card--compact .product-card__more { font-size: 0.8rem; }
  }
</style>
