---
import Icon from './Icon.astro';
import { site, waLink, waMessages } from '../data/site';

interface Props { title?: string; text?: string; message?: string }
const {
  title = 'Siap mendukung kelancaran operasional Anda',
  text = 'Diskusikan kebutuhan peralatan maupun layanan teknis bersama tim kami. Kami akan menyiapkan rekomendasi solusi beserta penawaran resmi untuk Anda.',
  message = waMessages.general,
} = Astro.props;
---
<section class="cta">
  <div class="container cta__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta__actions">
      <a class="btn btn--primary" href={waLink(message)} target="_blank" rel="noopener"><Icon name="whatsapp" /> Konsultasi via WhatsApp</a>
      <a class="btn btn--ghost-light" href={`tel:${site.phone.tel}`}><Icon name="phone" /> {site.phone.display}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background:
      radial-gradient(circle at 10% 120%, rgb(245 181 46 / 0.18), transparent 45%),
      linear-gradient(120deg, var(--navy-900), var(--navy-700));
    color: #c9d5e8;
    padding-block: clamp(2.75rem, 2rem + 3vw, 4rem);
  }
  .cta__inner { display: grid; gap: 1.5rem; align-items: center; }
  @media (min-width: 900px) { .cta__inner { grid-template-columns: 1fr auto; gap: 3rem; } }
  h2 { color: #fff; margin-bottom: 0.4rem; }
  p { margin: 0; max-width: 56ch; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
