---
// Grid logo klien dengan kartu seragam: area logo bertinggi tetap, nama maksimal dua baris.
import { Image } from 'astro:assets';
import type { clients as allClients } from '../data/clients';

interface Props {
  items: typeof allClients;
  /** Tampilkan nama di bawah logo. */
  names?: boolean;
}
const { items, names = true } = Astro.props;
---
<ul class:list={['clients', { 'clients--compact': !names }]}>
  {items.map((c) => (
    <li class="client">
      <span class="client__logo">
        <Image src={c.logo} alt={c.name} height={112} densities={[1]} loading="lazy" />
      </span>
      {names && <span class="client__name">{c.name}</span>}
    </li>
  ))}
</ul>

<style>
  .clients {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 480px) { .clients { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 768px) { .clients { grid-template-columns: repeat(4, 1fr); gap: 1rem; } }
  @media (min-width: 1100px) { .clients { grid-template-columns: repeat(5, 1fr); } }
  @media (min-width: 1100px) { .clients--compact { grid-template-columns: repeat(6, 1fr); } }

  .client {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1.1rem 0.9rem 1rem;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-align: center;
    transition: box-shadow 0.2s, transform 0.2s, border-color 0.2s;
  }
  .client:hover { border-color: transparent; box-shadow: var(--shadow-lg); transform: translateY(-2px); }
  .client__logo { display: grid; place-items: center; width: 100%; height: 64px; }
  .client__logo :global(img) { max-width: 100%; max-height: 52px; width: auto; height: auto; object-fit: contain; }
  .client__name {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.7em;
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text-muted);
  }
  .clients--compact .client { padding: 0.9rem; }
  .clients--compact .client__logo { height: 56px; }
  .clients--compact .client__logo :global(img) { max-height: 44px; }
</style>
